{
  "name": "ai-writing-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env.local server/index.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:live": "node --env-file-if-exists=.env.local tests/live-check.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.7.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
